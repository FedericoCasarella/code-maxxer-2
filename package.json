{
  "name": "code-maxxer-2",
  "version": "0.1.6",
  "private": true,
  "description": "A team of AI agents that runs your project in loops, on top of Claude Code.",
  "main": "./out/main/index.js",
  "type": "module",
  "scripts": {
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "test": "node --experimental-strip-types --test test/*.test.ts",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "dist": "npm run typecheck && electron-vite build && ./scripts/build-dictate.sh && electron-builder --mac dmg --arm64"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "^41.7.1",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/language": "^6.13.1",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/merge": "^6.12.3",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@lezer/highlight": "^1.2.5",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "@xyflow/react": "^13.0.1",
    "chokidar": "^5.0.0",
    "clsx": "^2.1.1",
    "codemirror": "^6.0.2",
    "embedded-postgres": "^18.7.0-beta.19",
    "lucide-react": "^1.74.0",
    "node-pty": "^1.1.0",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "recharts": "^3.11.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.7.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "productName": "Code-Maxxer",
  "author": "Federico Casarella",
  "build": {
    "appId": "com.federicocasarella.codemaxxer",
    "productName": "Code-Maxxer",
    "asar": false,
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "out/**",
      "resources/**",
      "package.json",
      "!resources/dictate/main.swift",
      "!node_modules/@embedded-postgres/darwin-arm64/native/include/**",
      "!**/*.map"
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "build/icon.icns",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ],
      "identity": "-",
      "hardenedRuntime": false,
      "minimumSystemVersion": "13.0",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Code-Maxxer listens only while you dictate a message."
      }
    },
    "dmg": {
      "artifactName": "Code-Maxxer-${version}-${arch}.dmg"
    },
    "afterPack": "./scripts/after-pack.cjs"
  }
}
